# Discord application credentials
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-client-id-here
DISCORD_PUBLIC_KEY=your-public-key-here

# Optional: set this to your server's ID while developing.
# Guild-scoped commands update instantly; global commands take up to an hour.
DEV_GUILD_ID=your-test-server-id-here

# Tracker Network (Valorant, Overwatch, LoL, Rocket League, Marvel Rivals)
TRACKER_API_KEY=your-tracker-gg-api-key-here

# start.gg (Super Smash Bros. Ultimate)
STARTGG_API_KEY=your-startgg-api-token-here
